# Network & RPC Configuration
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# Wallet & Deployment Credentials
ADMIN_PRIVATE_KEY=your_wallet_private_key_here

# Deployed Contract Addresses (populate after running deploy.js)
LUCR_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
TIMELOCK_ADDRESS=0x0000000000000000000000000000000000000000
GOVERNOR_ADDRESS=0x0000000000000000000000000000000000000000

# Backend Service Configuration
PORT=8080
DATABASE_URL=postgresql://user:password@localhost:5432/beast_db
